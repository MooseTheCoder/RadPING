{
  "name": "radping",
  "productName": "RadPING",
  "version": "0.1.0",
  "description": "A modern, cross-platform RADIUS server test utility. A spiritual successor to NTRadPing.",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node test/radius.test.js && node test/integration.test.js && node test/profiles.test.js && node test/dictparser.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.radping.app",
    "productName": "RadPING",
    "files": [
      "electron/**/*",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  }
}
